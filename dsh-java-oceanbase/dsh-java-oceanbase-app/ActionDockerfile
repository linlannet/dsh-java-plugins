# dsh-java-oceanbase 运行镜像
# 构建上下文为仓库根目录，jar 由 GitHub Action 中的 Maven 步骤提前构建
FROM eclipse-temurin:17-jre

LABEL org.opencontainers.image.source="https://github.com:linlannet/dsh-java-plugins/dsh-java-oceanbase"

WORKDIR /app

COPY dsh-java-oceanbase-app/target/dsh-java-oceanbase-app-*.jar app.jar

EXPOSE 8093

ENV JAVA_OPTS=""

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
