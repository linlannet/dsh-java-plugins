# dsh-java-mysql 运行镜像
# 构建上下文为仓库根目录，jar 由 GitHub Action 中的 Maven 步骤提前构建
FROM eclipse-temurin:17-jre

LABEL org.opencontainers.image.source="https://github.com:linlannet/dsh-java-plugins/dsh-java-mysql"

WORKDIR /app

# 只拷贝 exec classifier 的 fat jar；瘦 jar（dsh-java-mysql-app-<version>.jar）不可直接运行
COPY dsh-java-mysql-app/target/dsh-java-mysql-app-*-exec.jar app.jar

EXPOSE 8091

ENV JAVA_OPTS=""

ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar app.jar"]
